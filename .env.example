FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Stripe (online card payments). Get test keys at https://dashboard.stripe.com/test/apikeys
# The secret key stays on the server; the publishable key is put in the checkout page.
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
# Only test keys (sk_test_...) are accepted unless this is set to true.
STRIPE_ALLOW_LIVE_KEYS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=showtime-marketplace
